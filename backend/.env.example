# Backend environment variables

# Port the server listens on (default: 5000)
PORT=5000

# Frontend origin allowed by CORS
ALLOWED_ORIGIN=https://codexug.com

# Nodemailer / email settings for the contact form
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
EMAIL_TO=info.codex2024@gmail.com

# GNews API key for the /api/news route
# Get a free key at https://gnews.io
# If not set, the route returns mock articles for development
GNEWS_API_KEY=your_gnews_api_key_here
